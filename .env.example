# Copy this file to .env and fill in values from your Supabase project
# (Project Settings -> API). The anon key is safe to expose to the browser;
# access is restricted by the Row Level Security policies in supabase/schema.sql.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
